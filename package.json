{
	"name": "@firefoxic/eslint-config",
	"description": "Shared config for eslint by firefoxic.",
	"version": "9.0.0",
	"license": "MIT",
	"author": {
		"name": "Sergey Artemov",
		"email": "firefoxic.dev@gmail.com"
	},
	"homepage": "https://github.com/firefoxic/eslint-config#readme",
	"bugs": {
		"url": "https://github.com/firefoxic/eslint-config/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/firefoxic/eslint-config.git"
	},
	"type": "module",
	"exports": {
		"default": "./lib/index.js",
		"types": "./lib/index.d.ts"
	},
	"files": [
		"./lib/**/*.d.ts",
		"./lib/**/*.js",
		"!**/*.test.js"
	],
	"engines": {
		"node": ">=24.18"
	},
	"peerDependencies": {
		"eslint": "^10.6.0"
	},
	"dependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint-plugin-simple-import-sort": "^13.0.0",
		"globals": "^17.7.0"
	},
	"scripts": {
		"help": "make help"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26.4",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": ">=11.9",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"@typescript-eslint/parser": "^8.62.1",
		"eslint": "^10.6.0"
	},
	"keywords": [
		"config",
		"eslint",
		"javascript",
		"js",
		"lint",
		"linter",
		"linting"
	]
}
